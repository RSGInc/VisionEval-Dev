Notes:
- VisionEval.cnf for Autonomous Vehicles VERSPM (single stage)
- Model Structural Parameters: ScriptsDir, InputDir, ParamDir, GeoFile, ModelParamFile
- Model Description: Model, Region, State
- Scenario Description (single stage): Scenario, Description, BaseYear, Years

# Model Structural Parameters
ScriptsDir     : scripts
InputDir       : inputs
ParamDir       : defs
GeoFile        : geo.csv
ModelParamFile : model_parameters.json # Located in InputDir
QueryDir       : queries
resultsPath    : results
#LoadDatastore : TRUE
Seed           : 1  # Same seed used for all scenarios

# Model description
Model          : VERSPM 3.0 AV
Region         : RVMPO
State          : OR
ModelStages    : # specify explicitly to avoid processing base scenario
    "assign-drivers":
      Dir: assign-drivers
      Reportable: true
